#!/bin/sh
mod=Super
yambar &
riverctl map normal $mod Return spawn foot
riverctl map normal $mod D spawn wmenu-run
riverctl map normal $mod Q close
riverctl map normal $mod+Shift E exit

riverctl map normal $mod J focus-view next
riverctl map normal $mod K focus-view previous
riverctl map normal $mod+Shift J swap next
riverctl map normal $mod+Shift K swap previous

for i in 1 2 3 4 5 6 7 8 9; do
  tags=$((1 << (i - 1)))
  riverctl map normal $mod $i set-focused-tags $tags
  riverctl map normal $mod+Shift $i set-view-tags $tags
done

riverctl keyboard-layout gb
riverctl background-color 0x002b36
riverctl border-color-focused 0x93a1a1
riverctl border-color-unfocused 0x586e75

riverctl default-layout rivertile
rivertile -view-padding 6 -outer-padding 6 &

riverctl map normal None Print spawn 'sh -c "grim -g \"$(slurp)\" - | wl-copy"'
riverctl map normal Shift Print spawn 'sh -c "grim -g \"$(slurp)\" - | satty -f - --copy-command wl-copy -o ~/Pictures/Screenshots/%Y%m%d_%H%M%S.png"'
riverctl map normal Control Print spawn 'sh -c "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png"'

touchpad="pointer-2-14-ETPS/2_Elantech_Touchpad"

riverctl input "$touchpad" tap enabled
riverctl ouchpad input "$touchpad" tap-button-map left-right-middle
riverctl ouchpad input "$touchpad" natural-scroll enabled
riverctl ouchpad input "$touchpad" disable-while-typing enabled
riverctl ouchpad input "$touchpad" drag enabled

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=river
# Volume (hold to repeat)
riverctl map -repeat normal None XF86AudioRaiseVolume spawn '/home/ns/.config/yambar/volume.sh up'
riverctl map -repeat normal None XF86AudioLowerVolume spawn '/home/ns/.config/yambar/volume.sh down'
riverctl map normal None XF86AudioMute spawn '/home/ns/.config/yambar/volume.sh mute'
riverctl map normal None XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'

# Brightness (hold to repeat)
riverctl map -repeat normal None XF86MonBrightnessUp spawn 'brightnessctl set 5%+'
riverctl map -repeat normal None XF86MonBrightnessDown spawn 'brightnessctl set 5%-'

# Media (optional)
riverctl map normal None XF86AudioPlay spawn 'playerctl play-pause'
riverctl map normal None XF86AudioNext spawn 'playerctl next'
riverctl map normal None XF86AudioPrev spawn 'playerctl previous'
