{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": ["river/tags", "river/window"],
  "modules-right": ["cpu", "memory", "network", "clock"],

  "river/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
  },
  "river/window": { "max-length": 50 },
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "cpu": { "format": "cpu {usage}%" },
  "memory": { "format": "ram {percentage}%" }
}